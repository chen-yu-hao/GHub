{
  "baseline": "0.164.0+",
  "notes": "Synthetic redacted protocol fixtures; IDs and paths are examples. No jsonrpc member.",
  "initialize": {
    "id": 1,
    "method": "initialize",
    "params": {
      "clientInfo": {
        "name": "remote_gpt_android",
        "title": "GHub",
        "version": "0.1.0"
      },
      "capabilities": {
        "experimentalApi": false
      }
    }
  },
  "initialized": {
    "method": "initialized",
    "params": {}
  },
  "resume": {
    "id": 2,
