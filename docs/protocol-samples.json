      "command": "printf 'probe\\n'",
      "cwd": "/tmp",
      "reason": "Connectivity check"
    }
  },
  "decision": {
    "id": "request-example",
    "result": {
      "decision": "accept"
    }
  },
  "resolved": {
    "method": "serverRequest/resolved",
    "params": {
      "threadId": "thread-example",
      "requestId": "request-example"
    }
  },
  "image": {
    "id": 3,
    "method": "turn/start",
    "params": {
      "threadId": "thread-example",
      "input": [
        {
          "type": "text",
          "text": "Explain this image"
